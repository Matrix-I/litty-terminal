# Litty injects this file by pointing ZDOTDIR here. Restore the user's
# ZDOTDIR, load their .zshenv, then the integration for interactive shells.
if [[ -n "${LITTY_ZDOTDIR+x}" ]]; then
  ZDOTDIR=$LITTY_ZDOTDIR
  unset LITTY_ZDOTDIR
else
  unset ZDOTDIR
fi

{
  typeset _litty_file=${ZDOTDIR-$HOME}/.zshenv
  [[ ! -r $_litty_file ]] || builtin source -- $_litty_file
} always {
  typeset _litty_dir=${LITTY_SHELL_INTEGRATION_DIR-}
  if [[ -o interactive && -n $_litty_dir ]]; then
    if [[ -r "$_litty_dir/zsh/litty-integration.zsh" ]]; then
      builtin source -- "$_litty_dir/zsh/litty-integration.zsh"
    fi
  fi
  builtin unset _litty_file _litty_dir
}
